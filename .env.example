# ============================================================================
# OPTION 1: TCS GenAI Lab MaaS (Default Production Standard)
# ============================================================================
MAAS_API_BASE_URL="https://genailab.tcs.in/v1"
MAAS_API_KEY="your_tcs_genai_lab_api_key_here"
MODEL_NAME="azure/genailab-maas-gpt-4o-mini"
EMBEDDING_MODEL_NAME="azure/genailab-maas-text-embedding-3-large"

# ============================================================================
# OPTION 2: Manual Testing via Google Gemini API
# To test with Gemini: Copy this file to .env and set your GEMINI_API_KEY below.
# The system automatically switches to Gemini.
# To revert back to TCS Lab / Offline: Simply delete .env or comment out GEMINI_API_KEY.
# ============================================================================
# GEMINI_API_KEY="AIzaSy..."
# MODEL_NAME="gemini-1.5-flash"
# EMBEDDING_MODEL_NAME="text-embedding-004"

# ============================================================================
# Network Host & Port Configurations
# ============================================================================
API_HOST="0.0.0.0"
API_PORT=8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="0.0.0.0"
